
@{
    ViewData["Title"] = "Select a Report";
}

<div class="container py-4">
    <h1 class="mb-2">Insurance Reports</h1>

    <p class="text-muted mb-4">
        Select a report to apply filters, preview results,
        and download the report in your preferred format.
    </p>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Policy Register</h5>

                    <p class="card-text">
                        View policies with issue dates, policyholders,
                        products, statuses, and premiums.
                    </p>

                    <a asp-controller="Reports"
                       asp-action="Index"
                       class="btn btn-primary mt-auto">
                        Open report
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Policy Status Report</h5>

                    <p class="card-text">
                        Review policy status changes, previous and new
                        statuses, change dates, and reasons.
                    </p>

                    <a asp-controller="PolicyStatusReport"
                       asp-action="Index"
                       class="btn btn-primary mt-auto">
                        Open report
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Premium Due Report</h5>

                    <p class="card-text">
                        Review premium-related records using
                        the report's available filters.
                    </p>

                    <a asp-controller="PremiumDueReport"
                       asp-action="Index"
                       class="btn btn-primary mt-auto">
                        Open report
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
