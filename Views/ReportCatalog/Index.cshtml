@{
    ViewData["Title"] = "Select a Report";
}

<div class="container py-4">

    <h1 class="mb-2">Insurance Reports</h1>

    <p class="text-muted mb-4">
        Select a report to apply filters, preview results,
        and download the report in your preferred format.
    </p>

    <div class="mb-4">
        <label for="reportSelector" class="form-label">
            Select Report
        </label>

        <select id="reportSelector" class="form-select">
            <option value="">-- Select a Report --</option>

            <option value="PolicyRegister">
                Policy Register
            </option>

            <option value="PolicyStatus">
                Policy Status Report
            </option>

            <option value="PremiumDue">
                Premium Due Report
            </option>

            <option value="PremiumCollection">
                Premium Collection Report
            </option>

            <option value="OutstandingPremium">
                Outstanding Premium Report
            </option>

            <option value="PremiumCollectionSummary">
                Premium Collection Summary
            </option>
        </select>
    </div>

    <div id="reportContainer">
        @* Selected report interface will appear here *@
    </div>

</div>
